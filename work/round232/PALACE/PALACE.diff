+  ok(ends.length === 39 && !ends.some((e) => e.id === "H16" || e.id === "H14"), `39 usable passages (lore H16 + H14 skipped): ${ends.length}`);
+  const no21 = SEC.passageEnds(PAL(0), ROT, (q) => q !== "21");
