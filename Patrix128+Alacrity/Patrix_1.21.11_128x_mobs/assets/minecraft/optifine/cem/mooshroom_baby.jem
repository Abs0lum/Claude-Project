					"body.ry": "torad(  ( var.hy/10*var.idl2 )  +(-cos(var.Bt/3   )/2    +sin(-pi/4 +var.ls  )*max(var.move, 0.5) )*var.walk*if(is_child,0.7,1)                                         +(-3  *sin(-pi/4+var.St)                )*var.swim                    -4*sin(var.St*1.5)*var.t_fall                                   +(-var.tq*(1-var.tp)  +var.tq/2*(1+cos(var.tp*pi  ))     )*(var.turnL+var.turnR)  +(     20*cos(var.ls/1.5) )*var.hurt                                   +5*cos(clamp(0.5+sin(-pi/18+var.It),0,1)*pi)*var.Nlook*(1-var.swim)    -1.5*cos(     var.id+age/3)*(var.Nlfleg+var.Nrbleg)  )",
					"body.rz": "torad(                           (                     -3*cos(-pi/4 +var.ls  )*max(var.move, 0.5) )*var.walk*if(is_child,0.7,1)  +( 4*sin(var.ls)*limb_speed )*var.run  +( 3  *cos(-pi/4+var.St)                )*var.swim                    +2*cos(var.St*1.5)*var.t_fall                                   +( var.tq/30*sin( var.tp*pi*2 )*(1-cos(var.tp*pi*2))     )*(var.turnL-var.turnR)  +(   -2.6*sin(var.ls    ) )*var.hurt  +2*cos(clamp(0.5-sin(-pi/12+var.It)*0.7,0,1)*pi)*(0.8-cos(var.It/4+sin(var.It/4)))*var.Nidle*(1-var.Neat) -3*cos(pi/4+var.id+age/3)*(var.Nlfleg+var.Nrbleg) -2*cos(var.id+age/1.3)*var.Nshake  )",
					"body.tx": "(  cos(var.Bt/3)/6*var.walk  +(   2*sin(torad(var.tq*var.tp))  *( 1+cos(var.tp*pi  ) )/2)*(var.turnL+var.turnR)  ) * if( is_child, 0.5, 1 )",
					"body.ty": "( if(is_child,34,12)-1.5 +( ( if(is_child,0.6,0.2) +cos(pi/9+var.ls*2)*0.24 )*var.move -sin(var.Bt)/9 )*var.walk  +( 0.25 +sin(pi/4+var.ls) )*limb_speed*var.run  +( var.jump -3*max(0,var.fall) +4*var.land )  +var.tq/90*( 1-cos(var.tp*pi*2) )/4*(var.turnL+var.turnR)  +( 2 +1*cos(var.ls) )*var.hurt  +( if(is_child,4,2) +1.5*sin(var.Neat*pi) )*var.Neat  ) * if( is_child, 0.5, 1 )",
					"body.tz": "( 1  -(2-2*cos(torad(var.tq*var.tp)) )*( 1+cos(var.tp*pi) )/2*(var.turnL+var.turnR)  +(     -cos(var.ls)*4 )*var.hurt  -0.4*var.Neat  ) * if( is_child, 0.5, 1 )",
