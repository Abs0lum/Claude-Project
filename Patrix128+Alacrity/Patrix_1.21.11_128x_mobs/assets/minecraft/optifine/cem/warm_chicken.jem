					"body.tx": "(  if(is_riding||is_ridden, 0, cos(var.Bt/3)/12*var.walk  +sin(var.St/3)*var.float ) -0.7*(var.Nlleg-var.Nrleg)  ) * if( is_child, 0.25, 1 )",
					"body.ty": "( if(is_child,40,17)+0.3 +if(!is_ridden&&is_riding, 5, 0) +( if(is_riding, 0,-sin(var.Bt)/18) +( 0.3+0.45*cos(      var.ls*2 +sin( pi/9 +var.ls*2 )/2 )     )*max(var.move, 0.2) )*var.walk  +( -0.5 +sin(pi/4+var.ls*2) )*limb_speed*var.run  +( var.jump +2*var.land )     +abs(var.tq)/70*( 1-cos(var.tp*pi*2) )/4*(var.turnL+var.turnR)  +( 2 +cos(var.ls) )*var.hurt  +( if(is_child,0,0.8) +0.5*sin(var.Neat*pi) )*var.Neat  +0.3*(var.Nlleg+var.Nrleg)  ) * if( is_child, 0.5, 1 )",
					"body.tz": "(                                                          (                               (    -0.3+0.3 *cos(pi/4 +var.ls*2 +sin(-pi/6 +var.ls*2 )/3 )*3.3 )*    var.move       )*var.walk              +if(is_ridden, 0, cos(var.St/2))*var.float          -(2-2*cos(torad(var.tq*var.tp)) )*( 1+cos(var.tp*pi) )/2*(var.turnL+var.turnR)  +( -2*cos(var.ls) )*var.hurt  -var.Neat  ) * if( is_child, 0.5, 1 )",
					"head2.rx": "      -body.rx                     +torad( head_pitch/1.2*(1-max(0,-1+var.Neat*2))   +( -0.5+sin(pi/4+var.ls) )*3*limb_speed*var.run/if(is_child,2,1)  +10*var.float  +(-7 +20*sin(var.ls/1.2) )*var.hurt  +7*cos(clamp(-2+sin(var.It/2 +sin(var.It/5)/2 )*6,0,1)*pi)*var.Nidle +(10 +15*cos(clamp(-3+sin(pi/32+var.It/3)*13,0,1)*pi) )*var.Nlook*(1-max(0,-1+var.Neat*2)) +(75 +20*sin(var.Npeck*1.7)*sin(var.Npeck) )*max(0,-1+var.Neat*2)    +( 7 +10*cos(var.Nshake*pi*1.5) -5*(-1+cos(clamp(-3+var.Nshake*4,0,1)*pi)) )*var.Nshake  )",
					"neck.rx": "(      -body.rx                     +torad( head_pitch/1.2*(1-max(0,-1+var.Neat*2))   +( -0.5+sin(pi/4+var.ls) )*3*limb_speed*var.run/if(is_child,2,1)  +10*var.float  +(-7 +20*sin(var.ls/1.2) )*var.hurt  +7*cos(clamp(-2+sin(var.It/2 +sin(var.It/5)/2 )*6,0,1)*pi)*var.Nidle +(10 +15*cos(clamp(-3+sin(pi/32+var.It/3)*13,0,1)*pi) )*var.Nlook*(1-max(0,-1+var.Neat*2)) +(68 +10*sin(var.Npeck*1.7)*sin(var.Npeck) )*max(0,-1+var.Neat*2)*3  +( 7 +10*cos(var.Nshake*pi*1.5) -5*(-1+cos(clamp(-3+var.Nshake*4,0,1)*pi)) )*var.Nshake  ) )/3",
