{
	"credit": "Patrix",
	"textureSize": [32, 32],
	"models": [
		{
			"part": "head",
			"id": "head",
			"invertAxis": "xy",
			"translate": [0, -6, 4],
			"submodels": [
				{
					"id": "Created_by_FreshLX_for_Patrix",
					"invertAxis": "xy",
					"translate": [0, 6, -4]
				}
			],
			"animations": [
				{
					"var.r": "random(id)*pi*4"
				},
				{
					"body_front.ry": "-body_back.ry/3.33",
					"body_front.tz": "if( is_in_water, 0, -body_back.ry*if(root.sy==0.5,0.75,root.sy==1.5,-0.6,-0.2) )",
					"body2.ry": "    if(is_in_water, sin(var.r+limb_swing+age/12)/5              *(1+limb_speed    ) +torad(head_yaw)/2, -cos(limb_swing+age/2)/8*2)",
					"body3.ry": "    if(is_in_water,-cos(var.r+limb_swing+age/12)/8              *(1+limb_speed*2  ) +torad(head_yaw)/2, -cos(limb_swing+age/2)/8*2)",
					"head2.ry": "    if(is_in_water,(cos(var.r+limb_swing+age/12)/10 -body2.ry/2)*(1+limb_speed*1.5) -torad(head_yaw)/3,  sin(limb_swing+age/2)/6*2)",
					"tail2.ry": "    if(is_in_water,-cos(var.r+limb_swing+age/12)/4              *(1+limb_speed*1.5) +torad(head_yaw)  , -sin(limb_swing+age/2)/3*2)",
					"fin_top.rz": "  if(is_in_water,-cos(var.r+limb_swing+age/12)/7  *(1+limb_speed*1.5)                               , -sin(limb_swing+age/2)/2)",
					"body2.tx": "    if(is_in_water, cos(var.r+limb_swing+age/12)/1.6*(1+limb_speed*2  )                               , -cos(limb_swing+age/2))",
					"body2.ty": "-5 +if(is_in_water, cos((pos_x*1.5+pos_y*2+pos_z*1.5)+age/17), 0)",
					"body2.tz": "-8",
					"head2.rx": "torad(-1)",
					"body3.rx": "torad( 1)",
					"body2.rx": "clamp(if(age>4&&var.y!=pos_y, -(pos_y-var.y), 0), -pi/3, pi/3)",
					"body2.rz": "    if(is_in_water, 0, torad(20) +torad(-40)*clamp(limb_speed*6, 0, 1) +sin(limb_swing +sin(limb_swing*2))/2 +limb_swing/2 -torad(90))",
					"body2.sx": "1 +(0.5-random(id))/2.4",
					"body2.sy": "body2.sx",
					"body2.sz": "body2.sx"
				},
				{
					"left_fin.rx": " torad(-90)",
					"right_fin.rx": "torad(-90)",
					"left_fin.ry": "             if(is_in_water, -cos(torad(30)+var.r+limb_swing/2+age/9 +sin(var.r+limb_swing/2+age/18)/2)/4*clamp(1-limb_speed*6, 0, 1)                                                                        , 0)",
					"right_fin.ry": "            if(is_in_water,  sin(torad(30)+var.r+limb_swing/2+age/9 +cos(var.r+limb_swing/2+age/18)/2)/4*clamp(1-limb_speed*6, 0, 1)                                                                        , 0)",
					"left_fin.rz": " torad( 60) +if(is_in_water,  cos(          var.r+limb_swing/2+age/9 +sin(var.r+limb_swing/2+age/18)  )/2*clamp(1-limb_speed*6, 0, 1) +(torad(-20) +sin(var.r+limb_swing+age/12)/6)*clamp(limb_speed*6, 0, 1),  sin(age/1.5)/2)",
					"right_fin.rz": "torad(-60) +if(is_in_water, -sin(          var.r+limb_swing/2+age/9 +cos(var.r+limb_swing/2+age/18)  )/2*clamp(1-limb_speed*6, 0, 1) +(torad( 20) +sin(var.r+limb_swing+age/12)/6)*clamp(limb_speed*6, 0, 1), -sin(age/1.5)/2)",
					"left_fin_b.rz": " torad(-30) +if(is_in_water, cos(var.r+limb_swing+age/12)/7 *(1+limb_speed*1.5), 0)",
					"right_fin_b.rz": "torad( 30) +if(is_in_water, cos(var.r+limb_swing+age/12)/7 *(1+limb_speed*1.5), 0)"
				},
				{
					"var.y": "var.y2",
					"var.y2": "var.y3",
					"var.y3": "var.y4",
					"var.y4": "var.y5",
					"var.y5": "var.y6",
					"var.y6": "var.y7",
					"var.y7": "var.y8",
					"var.y8": "var.y9",
					"var.y9": "var.y10",
					"var.y10": "pos_y"
				}
			]
		},
