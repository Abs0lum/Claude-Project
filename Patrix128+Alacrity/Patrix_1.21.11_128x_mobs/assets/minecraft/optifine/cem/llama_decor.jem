				}
			],
			"animations": [
				{
					"var.hy": "clamp(head_yaw,-90,90)",
					"var.child_scale": "if(is_child, 1, 0)",
					"var.r": "random(id)*pi*4",
					"var.ls": "limb_swing*if(is_child, 0.7, 1)",
					"var.lsj": "limb_swing/if(is_child, 2, 1.3)",
					"var.b": "var.r +age/if(is_child, 40, 75)*pi*2",
					"var.swim": "var.r +limb_swing/6 +age/if(is_child, 13, 18)*pi*2",
					"var.run": "clamp(if(limb_speed >= if(is_child, 0.4, 0.7), min(20, var.run +0.1 *frame_time*20), max(0, var.run -0.1 *frame_time*20)), 0, if(is_child, 1.3, 1))",
					"var.walk": "clamp(1-var.run, 0, 1)"
				},
				{
					"head2.rx": "-head.rx +torad(head_pitch)/1.5 -if(!is_on_ground&&is_in_water, torad(-5) +sin(var.swim)/10, cos(var.ls*2)/14*clamp(limb_speed*2, 0, 1)*var.walk -(-cos(var.lsj)/12 -torad(5))*limb_speed*var.run ) +sin(var.b+torad(90))/70 +(torad(10)*limb_speed)",
					"head2.rz": "-head.rz -sin(torad( 0)+var.ls)/20*clamp(limb_speed*2, 0, 1)*var.walk",
					"head2.ry": "-head.ry +sin(torad(90)+var.ls)/16*clamp(limb_speed*2, 0, 1)*var.walk +torad(var.hy)",
					"head2.tx": "clamp(-torad(var.hy)*2*if(is_ridden, 0, clamp(1-limb_speed*4, 0, 1)), torad(-2), torad(2))",
					"head2.ty": "-17.5 +if(!is_on_ground&&is_in_water, if(is_ridden, 0, 4) +sin(var.swim), -sin(torad(-45)+var.ls*2)*clamp(limb_speed*2, 0, 1)*var.walk -(cos(+var.lsj -sin(var.lsj)/2)*3 +2)*limb_speed*var.run ) -sin(var.b+torad(90))/4",
					"head2.tz": "-6.5 +if(!is_on_ground&&is_in_water, -sin(torad(-45)+var.swim)/2, (sin(-pi/4 +var.lsj -cos(var.lsj)/3) -1)*limb_speed*var.run)",
					"body_rotation.rx": "if(!is_on_ground&&is_in_water, torad(-10) +sin(var.swim)/10, -sin(var.ls*2)/10*clamp(limb_speed*2, 0, 1)*var.walk +(-sin(var.lsj)/8 +torad(5))*limb_speed*var.run ) +sin(var.b-torad(45))/60",
					"body_rotation.ry": "sin(var.ls)/20*clamp(limb_speed*2, 0, 1)*var.walk",
					"body_rotation.rz": "clamp(-torad(var.hy)/7*if(is_ridden, 0, clamp(1-limb_speed*4, 0, 1)), torad(-5), torad(5))",
					"body_rotation.tx": "0",
					"body_rotation.ty": "if(!is_on_ground&&is_in_water, sin(torad(-45)+var.swim)/2, sin(torad(-135)+var.ls*2)/4*clamp(limb_speed*2, 0, 1)*var.walk +(sin(-pi/4 +var.lsj) -1)*limb_speed*var.run ) -18.5",
					"body_rotation.tz": "if(!is_on_ground&&is_in_water, if(is_ridden, 0, -5), if(is_ridden, 1, -1)*limb_speed +cos(var.ls)/2*clamp(limb_speed*2, 0, 1)*var.walk +(cos(var.lsj)*3 +3)*limb_speed*var.run ) +2.2 +sin(var.b)/6",
					"render.leash_offset_x": "-(head2.tx                    )/16/if(is_child, 2, 1)",
					"render.leash_offset_y": "-(head2.ty +if(is_child, 8, 0))/16/if(is_child, 2, 1)",
					"render.leash_offset_z": "-(head2.tz -1                 )/16/if(is_child, 2, 1)"
				},
				{
					"leg1.rx": " sin(var.b)/60 +if(!is_on_ground&&is_in_water,  sin(var.swim)/2, ((asin(sin(torad(-90+20)+var.ls))/4 +torad( 10))*clamp(limb_speed*8, 0.4, 1) +clamp(sin(torad( 0 +20)+var.ls)/3, torad(-30), 0)*if(is_child, 1.5, 1)*clamp(limb_speed*8, 0, 1))*var.walk +(-sin(pi/4 +var.lsj -sin(var.lsj)/3)/3 +torad(10) )*limb_speed*var.run ) -torad(5)",
					"leg2.rx": " sin(var.b)/60 +if(!is_on_ground&&is_in_water, -sin(var.swim)/2, ((asin(sin(torad( 90+20)+var.ls))/4 +torad( 10))*clamp(limb_speed*8, 0.4, 1) +clamp(sin(torad(180+20)+var.ls)/3, torad(-30), 0)*if(is_child, 1.5, 1)*clamp(limb_speed*8, 0, 1))*var.walk +(-sin(      var.lsj -sin(var.lsj)/3)/3 +torad(10) )*limb_speed*var.run ) -torad(5)",
					"leg3.rx": "-sin(var.b)/60 +if(!is_on_ground&&is_in_water, -sin(var.swim)/2, ((asin(sin(torad(180   )+var.ls))/4 +torad(-10))*clamp(limb_speed*8, 0.4, 1) +clamp(sin(torad( 90   )+var.ls)/3, 0, torad( 30))*if(is_child, 1.5, 1)*clamp(limb_speed*8, 0, 1))*var.walk +(-sin(pi/4 +var.lsj -sin(var.lsj)/3)/3 +torad( 5) )*limb_speed*var.run ) +torad(5)",
					"leg4.rx": "-sin(var.b)/60 +if(!is_on_ground&&is_in_water,  sin(var.swim)/2, ((asin(sin(torad( 0    )+var.ls))/4 +torad(-10))*clamp(limb_speed*8, 0.4, 1) +clamp(sin(torad(-90   )+var.ls)/3, 0, torad( 30))*if(is_child, 1.5, 1)*clamp(limb_speed*8, 0, 1))*var.walk +(-sin(      var.lsj -sin(var.lsj)/3)/3 +torad( 5) )*limb_speed*var.run ) +torad(5)",
					"leg1.ry": "torad(-5 )*clamp(1-limb_speed*8, 0, 1)",
					"leg2.ry": "torad( 5 )*clamp(1-limb_speed*8, 0, 1)",
					"leg3.ry": "torad( 5 )*clamp(1-limb_speed*8, 0, 1)",
					"leg4.ry": "torad(-5 )*clamp(1-limb_speed*8, 0, 1)",
					"leg1.rz": "if(!is_on_ground&&is_in_water, torad( 8), 0) +if(is_child, -torad(5), 0)",
					"leg2.rz": "if(!is_on_ground&&is_in_water, torad(-8), 0) +if(is_child,  torad(5), 0)",
					"leg3.rz": "if(!is_on_ground&&is_in_water, torad( 8), 0) +if(is_child, -torad(5), 0)",
					"leg4.rz": "if(!is_on_ground&&is_in_water, torad(-8), 0) +if(is_child,  torad(5), 0)",
					"leg1.tx": "(-3.2 +if(!is_on_ground&&is_in_water, -1, 0) ) * (1-0.5*var.child_scale)",
					"leg2.tx": "( 3.2 +if(!is_on_ground&&is_in_water,  1, 0) ) * (1-0.5*var.child_scale)",
					"leg3.tx": "(-3   +if(!is_on_ground&&is_in_water, -2, 0) ) * (1-0.5*var.child_scale)",
					"leg4.tx": "( 3   +if(!is_on_ground&&is_in_water,  2, 0) ) * (1-0.5*var.child_scale)",
					"leg1.ty": "( if(is_child, 25, 24) +if(!is_on_ground&&is_in_water, if(is_ridden, 0, 5) +sin(torad( 90)+var.swim)*1.5, clamp( (-1*limb_speed +sin(torad( 0 +20)+var.ls)*if(is_child, 3, 2)*clamp(limb_speed*8, 0, 1))*var.walk +(-cos(pi/4 +var.lsj)*3 -2.5)*limb_speed*var.run, -6, 0)) ) * (1-0.5*var.child_scale) +if(is_child, 11.5, 0)*var.child_scale",
					"leg2.ty": "( if(is_child, 25, 24) +if(!is_on_ground&&is_in_water, if(is_ridden, 0, 5) +sin(torad(-90)+var.swim)*1.5, clamp( (-1*limb_speed +sin(torad(180+20)+var.ls)*if(is_child, 3, 2)*clamp(limb_speed*8, 0, 1))*var.walk +(-cos(      var.lsj)*3 -2.5)*limb_speed*var.run, -6, 0)) ) * (1-0.5*var.child_scale) +if(is_child, 11.5, 0)*var.child_scale",
					"leg3.ty": "( if(is_child, 25, 24) +if(!is_on_ground&&is_in_water, if(is_ridden, 0, 3) +sin(torad(-90)+var.swim)*1.5, clamp( (-1*limb_speed +sin(torad(-90   )+var.ls)*if(is_child, 3, 2)*clamp(limb_speed*8, 0, 1))*var.walk +(-cos(pi/4 +var.lsj)*3 -2.5)*limb_speed*var.run, -6, 0)) ) * (1-0.5*var.child_scale) +if(is_child, 11.5, 0)*var.child_scale",
					"leg4.ty": "( if(is_child, 25, 24) +if(!is_on_ground&&is_in_water, if(is_ridden, 0, 3) +sin(torad( 90)+var.swim)*1.5, clamp( (-1*limb_speed +sin(torad( 90   )+var.ls)*if(is_child, 3, 2)*clamp(limb_speed*8, 0, 1))*var.walk +(-cos(      var.lsj)*3 -2.5)*limb_speed*var.run, -6, 0)) ) * (1-0.5*var.child_scale) +if(is_child, 11.5, 0)*var.child_scale",
					"leg1.tz": "( 6 +if(!is_on_ground&&is_in_water,  sin(var.swim)*6, asin(sin(torad(-90+20) +var.ls))*4*clamp(limb_speed*8, 0.4, 1)*var.walk +(-sin(pi/4 +var.lsj -sin(var.lsj)/2)*5 +1)*limb_speed*var.run ) ) * (1-0.5*var.child_scale)",
					"leg2.tz": "( 6 +if(!is_on_ground&&is_in_water, -sin(var.swim)*6, asin(sin(torad( 90+20) +var.ls))*4*clamp(limb_speed*8, 0.4, 1)*var.walk +(-sin(      var.lsj -sin(var.lsj)/2)*5 +1)*limb_speed*var.run ) ) * (1-0.5*var.child_scale)",
					"leg3.tz": "(-4 +if(!is_on_ground&&is_in_water, -sin(var.swim)*6, asin(sin(torad(180   ) +var.ls))*4*clamp(limb_speed*8, 0.4, 1)*var.walk +(-sin(pi/4 +var.lsj -sin(var.lsj)/2)*5 +1)*limb_speed*var.run ) ) * (1-0.5*var.child_scale)",
					"leg4.tz": "(-4 +if(!is_on_ground&&is_in_water,  sin(var.swim)*6, asin(sin(torad( 0    ) +var.ls))*4*clamp(limb_speed*8, 0.4, 1)*var.walk +(-sin(      var.lsj -sin(var.lsj)/2)*5 +1)*limb_speed*var.run ) ) * (1-0.5*var.child_scale)",
					"leg1.sy": "if(is_child, 0.75 -0.3*var.child_scale, 1)",
