				{
					"varb.pfc": "frame_counter == var.pre_frame_counter",
					"var.hy": "if( varb.pfc, var.hy, clamp(head_yaw,-90,90)*min(1,frame_time*9) +var.hy*max(0,1-frame_time*9) )",
					"var.testing": "0",
					"var.r": "random(id)*pi*4",
					"var.b": "var.r +age/if(is_child, 18, 40)*pi",
					"var.hurt": "(hurt_time/10)*(hurt_time/10)*max(0, (1-hurt_time/10)*8 ) -cos(death_time/6)*clamp(death_time/2, 0, 1)",
					"var.swim": "var.r +age/if(is_child, 11, 15)*pi +limb_swing/4",
					"var.digging": "clamp(if(body.ty>1 && !is_in_water && is_on_ground, min(20, var.digging +0.2 *frame_time*20), max(0, var.digging -0.2 *frame_time*20)), 0, 1)",
					"var.jump": "   clamp(if(age>8&& !is_in_water && !is_on_ground && !is_riding, min(20, var.jump +0.5 *frame_time*20), max(0, var.jump -0.5 *frame_time*20)), 0, 1)",
					"var.walk": "min(0.35, min(0.5, 16*limb_speed))",
					"var.nov1": "clamp( if( is_in_water || !is_on_ground, 0, (0.5-0.5*cos( clamp((-185.3 +sin(var.r +age/340)*186)*1.4, 0, 1)*pi )) ), 0, 1 )",
					"var.nov2": "(0.5-0.5*cos( clamp(-2 +sin(var.r +age/60)*3, 0, 1-var.nov1)*pi ))*(1-var.digging)",
					"var.look": " clamp(if(head_pitch!=0, min(20, var.look +0.2 *frame_time*20), max(0, var.look -0.2 *frame_time*20)), 0, 1-var.nov1)",
					"var.Lear": "clamp( cos(          var.r +age/1.5/20 ) *20 -20 +1 , 0 , clamp( sin( var.r +age/1.5/(20*12) )*8 -5 , 0 , 1 ) )",
					"var.Rear": "clamp( cos( pi/1.52 +var.r +age/1.5/15 ) *15 -15 +1 , 0 , clamp( sin( var.r +age/1.5/(15*12) )*8 -5 , 0 , 1 ) )",
					"var.yrot_offset": "if( varb.pfc, var.yrot_offset, var.yrot_offset +if( between( var.pre_roty-rot_y, -pi*2, -pi*2+0.2 ), -pi*2, between( var.pre_roty-rot_y, pi*2-0.2, pi*2 ), pi*2, 0 ) )",
					"var.roty": "rot_y +var.yrot_offset",
					"var.headroty": "var.pre_headroty+if(is_riding,0,var.roty)",
					"var.head_rot": "if( varb.pfc, var.head_rot,      !equals(var.headroty,var.pre_Oheadroty,1),                           var.headroty,                             var.headroty*min(1,frame_time*16) +var.head_rot*max(0,1-frame_time*16) )",
					"var.rotation": "if( varb.pfc, var.rotation, is_riding || !equals(var.roty,var.pre_Oroty,1),                               var.roty,                                 var.roty*min(1,frame_time*9 ) +var.rotation*max(0,1-frame_time*9 ) )",
					"var.position": "if( varb.pfc, var.position, is_riding ||     !equals(pos_y,var.pre_posy,2),                                  pos_y,                                    pos_y*min(1,frame_time*16) +var.position*max(0,1-frame_time*16) )",
					"var.flopposy": "if( varb.pfc, var.flopposy, is_riding ||     !equals(pos_y,var.pre_posy,2), pos_y-var.pre_bodyposy/10*(1-var.jump), (pos_y-var.pre_bodyposy/10*(1-var.jump))*min(1,frame_time*16) +var.flopposy*max(0,1-frame_time*16) )",
