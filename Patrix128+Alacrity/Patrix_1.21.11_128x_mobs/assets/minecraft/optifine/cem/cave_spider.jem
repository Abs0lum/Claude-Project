					"leg_RF_b.rz": "torad( 60)*if(!is_alive, 0.4 +sin(age*1.5)/80, 1) + sin(var.b)/60  -clamp( var.pitch/12,  0, pi) +clamp(-torad(head_yaw)/14, -pi, 0) +clamp(-cos(var.ls)/5*limb_speed, if(!is_on_ground, -pi, 0), pi) +cos(var.ls*2)/4  /6 +sin(var.ls)/3  /1.3 +if(!is_on_ground && is_hurt, -sin(hurt_time/10*pi)/2, 0) +sin(swing_progress*pi)/4 +if(!is_on_ground, torad(-30)*limb_speed -sin(age/3+limb_speed)/4, 0)",
