{
	"credit": "Created by FreshLX",
	"textureSize": [64, 32],
	"models": [
		{
			"part": "body",
			"id": "body",
			"invertAxis": "xy",
			"translate": [0, 0, 0]
		},
		{
			"part": "head",
			"id": "head",
			"invertAxis": "xy",
			"translate": [0, -9, 3],
			"submodels": [
				{
					"id": "Created_by_FreshLX",
					"invertAxis": "xy",
					"translate": [0, 0, 0]
				},
				{
					"id": "pitch",
					"invertAxis": "xy",
					"translate": [0, 0, 0]
				},
				{
					"id": "pedipalp",
					"invertAxis": "xy",
					"translate": [0, 9, -3]
				}
			],
			"animations": [
				{
					"var.scale": "-0.4*random(id) -0.2",
					"var.r": "random(id)*pi*4",
					"var.b": "((limb_swing/2+age)/25*pi*2)*(1-var.scale*5 +0.2)",
					"var.ls": "limb_swing/0.9*(1-var.scale*2)",
					"var.die": "if(!is_alive, if(is_hurt, (cos(hurt_time/4)/1.8 +0.4), 1), 0)",
					"var.pitch": "torad(head_pitch)*clamp(1-limb_speed*2, 0, 1)",
					"var.pedipalp": "if(!is_alive, 0, clamp(-1 +cos(var.r+(age+limb_swing)/27)*4, 0, 1) )*clamp(1-limb_speed*2, 0, 1)",
					"render.shadow_size": "(1 +var.scale)/2"
				},
				{
					"right_jaw.tx": "-1.25 +clamp(if(is_alive, -sin((limb_swing/2+age)/5*pi*2)/8, 0) -sin(swing_progress*pi*2)/2, -1, 0.3)",
					"left_jaw.tx": "-right_jaw.tx",
					"right_jaw.rx": "-sin(swing_progress*pi)*1.5",
					"left_jaw.rx": " -sin(swing_progress*pi)*1.5",
					"right_jaw.ry": "torad(8) +if(is_alive, sin((limb_swing/2+age)/5*pi*2)/12, 0) +sin(swing_progress*pi*2)/6",
					"left_jaw.ry": "-right_jaw.ry",
					"palpL1.tz": "-0.75 -sin(swing_progress*pi*2)",
					"palpR1.tz": "-0.75 -sin(swing_progress*pi*2)",
					"palpL1.rx": "torad(-22) -var.pitch/1.8 -torad(head_yaw)/6                             -cos(var.b)/30 +sin((limb_swing/2+age)/48*pi*2 +cos((limb_swing/2+age)/24*pi*2)/2)/3*var.pedipalp +if(is_hurt, sin(hurt_time/10*pi)/4, 0)",
					"palpR1.rx": "torad(-22) -var.pitch/1.8 +torad(head_yaw)/6                             -cos(var.b)/30 -sin((limb_swing/2+age)/48*pi*2 -cos((limb_swing/2+age)/24*pi*2)/2)/3*var.pedipalp +if(is_hurt, sin(hurt_time/10*pi)/4, 0)",
					"palpL1.ry": "torad(-10) -sin(swing_progress*pi*2)/3 -torad(20)*sin(swing_progress*pi)",
					"palpR1.ry": "torad( 10) +sin(swing_progress*pi*2)/3 +torad(20)*sin(swing_progress*pi)",
					"palpL2.rx": "            sin(swing_progress*pi*2)/4",
					"palpR2.rx": "            sin(swing_progress*pi*2)/4",
					"palpL3.rz": "torad( 90) -sin(swing_progress*pi*2) -torad(40)*sin(swing_progress*pi)  +cos(var.b)/20 +(torad( 10) -sin((limb_swing/2+age)/24*pi*2)/3)*var.pedipalp +if(is_hurt,  sin(hurt_time/10*pi)/2, 0)",
					"palpR3.rz": "torad(-90) +sin(swing_progress*pi*2) +torad(40)*sin(swing_progress*pi)  -cos(var.b)/20 +(torad(-10) -sin((limb_swing/2+age)/18*pi*2)/3)*var.pedipalp +if(is_hurt, -sin(hurt_time/10*pi)/2, 0)"
				},
				{
					"front.rx": "var.pitch/4 -sin(swing_progress*pi)/2 +sin(var.b-torad(45))/40 +if(is_hurt, sin(hurt_time/10*pi)/2, 0) +if(!is_alive, torad( 20), 0)",
					"front.ry": "clamp(torad(head_yaw)/2, torad(-12), torad(12))",
					"front.rz": "sin(torad(45)+var.ls)/15*limb_speed",
					"body2.rx": "var.pitch/3 -sin(swing_progress*pi)/3 +if(!is_on_ground && is_hurt, -sin(hurt_time/10*pi)/2, is_on_ground, 0, -limb_speed/3) +if(!is_alive, torad(-5), 0)",
					"legs.rx": " var.pitch/3                           +if(!is_on_ground && is_hurt, -sin(hurt_time/10*pi)/2, is_on_ground, 0, -limb_speed/3) +if(!is_alive, torad(-5), 0)",
					"body2.ry": "clamp(torad(head_yaw)/3, torad(-30), torad(30))",
					"legs.ry": " clamp(torad(head_yaw)/3, torad(-30), torad(30))/3*clamp(limb_speed*8, 0, 1)",
					"body2.tz": "-sin(swing_progress*pi)*3",
					"legs.tz": " -sin(swing_progress*pi)*4",
					"back.rx": "torad(10) -var.pitch/4 +sin(var.b+torad(90))/40 +sin(swing_progress*pi*2)/4 +if(is_hurt, -sin(hurt_time/10*pi)/2, 0) +if(!is_alive, torad(-10), 0)",
					"back.ry": "clamp(-torad(head_yaw)/6, torad(-15), torad(15))",
					"back.rz": "sin(torad(135)+var.ls)/10*limb_speed",
					"neck.rx": "if(!is_on_ground && is_hurt, -sin(hurt_time/10*pi)/30, 0)",
					"neck.ty": "15.5 +sin(var.b)/(8-8*var.scale) +if(!is_on_ground && is_hurt, -sin(hurt_time/10*pi)*2, 0) +10*var.die*(1+var.scale) -9*var.scale",
					"legs.ty": "-9",
					"neck.sx": "1+var.scale",
					"neck.sy": "1+var.scale",
					"neck.sz": "1+var.scale"
				},
				{
					"leg_LF_2.rx": "torad(-17.5)                                                                                   -var.pitch/6.2",
					"leg_LF_2.rz": "torad( 5)                                                 +clamp(-var.pitch/2.5, -pi, 0) +clamp(-var.pitch/2.2, 0, pi)",
					"leg_LF_2.ry": "                                                    sin(var.b)/180 +clamp( var.pitch/14, -pi, 0)                                                                                                                                           +sin(var.ls)/7                                                                -sin(swing_progress*pi)/7",
					"leg_LF_b.rz": "torad(-60)*if(!is_alive, 0.4 +sin(age*1.5)/80, 1) - sin(var.b)/60  +clamp( var.pitch/12,  0, pi) +clamp(-torad(head_yaw)/14,  0, pi) +clamp(-cos(var.ls)/5*limb_speed, -pi, if(!is_on_ground, pi, 0)) -cos(var.ls*2)/4  /6 +sin(var.ls)/3  /1.3 +if(!is_on_ground && is_hurt, sin(hurt_time/10*pi)/2, 0) -sin(swing_progress*pi)/4 +if(!is_on_ground, torad( 30)*limb_speed -sin(age/3+limb_speed)/4, 0)",
					"leg_LF_c.rz": "torad( 90)*if(!is_alive, 1.1 +sin(age*1.5)/80, 1) + sin(var.b)/120 +clamp(-var.pitch/12, -pi, 0) +clamp( torad(head_yaw)/12, -pi, 0) +clamp(-cos(var.ls)/4*limb_speed, -pi, if(!is_on_ground, pi, 0)) +cos(var.ls*2)/3.5/6 -sin(var.ls)/2.5/1.3 +if(!is_on_ground && is_hurt, sin(hurt_time/10*pi)/6, 0) +sin(swing_progress*pi)/4 +if(!is_on_ground, torad(-30)*limb_speed +cos(age/3+limb_speed)/6, 0)",
					"leg_LF_d.rz": "torad( 30)*if(!is_alive, 1.8 +sin(age*1.5)/20, 1) - sin(var.b)/200 +clamp(-var.pitch/12, -pi, 0) +clamp( torad(head_yaw)/12, -pi, 0) +clamp(-cos(var.ls)/5*limb_speed, -pi, if(!is_on_ground, pi, 0)) +cos(var.ls*2)/4  /6 -sin(var.ls)/3  /1.3 +if(!is_on_ground && is_hurt, sin(hurt_time/10*pi)/3, 0) +sin(swing_progress*pi)/4 +if(!is_on_ground, torad(-10)*limb_speed +cos(age/3+limb_speed)/8, 0)",
