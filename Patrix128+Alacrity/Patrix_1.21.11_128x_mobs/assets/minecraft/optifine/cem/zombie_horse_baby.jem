					"back_right_leg.tz": " (  9    +( ( ( sin(var.ls -sin(var.ls)/4.5 ) +1/6.5 )*var.trot  -cos(var.ls +cos(var.ls)/2.5              )*(1-var.trot) )*if(is_child,7,6.5)*max(0.3, var.move)*if(is_on_ground, 1, (1-var.rearing)))*var.walk  +(-cos(pi/6+var.ls -cos(pi/2.4+var.ls)/3*max(0,-5+var.move))*8*limb_speed*if(is_child,1.2,1)*if(is_on_ground, 1, (1-var.rearing)))*var.run  +(-sin(var.St)*6                 )*var.swim     -2.5*var.rearing                                      +( -cos(var.id+age/3 -sin(var.id+age/3)/2)*1.5 )*var.Nrbleg  ) * if( is_child, 0.5, 1 )",
