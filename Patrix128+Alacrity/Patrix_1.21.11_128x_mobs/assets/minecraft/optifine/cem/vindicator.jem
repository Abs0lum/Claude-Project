					"right_leg.rz": "if(is_riding, 0, varb.swim, 0, (torad( 5 ) +sin(torad(-10)+var.ls)/3*limb_speed)*var.Rmelee  + torad( 5)*clamp(1-limb_speed*2, 0, 1)*var.Lmelee -torad(var.hy)/45*clamp(1-limb_speed*2, 0, 1) )                                         +torad(2.5 )*var.pose",
					"left_leg.rz": " if(is_riding, 0, varb.swim, 0, (torad(-5 ) +sin(torad(-10)+var.ls)/3*limb_speed)*var.Lmelee  + torad(-5)*clamp(1-limb_speed*2, 0, 1)*var.Rmelee -torad(var.hy)/45*clamp(1-limb_speed*2, 0, 1) )                                         +torad(-12 )*var.pose",
					"right_leg.tx": "  -2 +if(varb.swim,         0, -2*(1-limb_speed)*var.Rmelee                                                                                        ) +(-0.75)*var.pose",
					"left_leg.tx": "    2 +if(varb.swim,         0,  2*(1-limb_speed)*var.Lmelee                                                                                        ) +( 1   )*var.pose",
					"right_leg.ty": "  24 +if(varb.swim, body.ty -14*var.cswim -0.8*clamp(limb_speed*8, 0, 1) -sin(pi*swing_progress)*4, clamp( cos(var.ls)*2*var.ws +clamp(2-limb_speed*6, -3, 0) +(-sin(torad(-30)+var.ls)*2 +head.ty)*clamp(-1+limb_speed*3, 0, 1), -8, 0.2)    ) +14*var.cswim -sin(hurt_time*pi/10)*2",
					"left_leg.ty": "   24 +if(varb.swim, body.ty -14*var.cswim -0.8*clamp(limb_speed*8, 0, 1) -sin(pi*swing_progress)*4, clamp(-cos(var.ls)*2*var.ws +clamp(2-limb_speed*6, -3, 0) +( sin(torad(-30)+var.ls)*2 +head.ty)*clamp(-1+limb_speed*3, 0, 1), -8, 0.2)    ) +14*var.cswim -sin(hurt_time*pi/10)*2",
					"right_leg.tz": "-0.2 +if(varb.swim, todeg(body.rx)/6 -sin(pi/4+var.sb)/1.5 -cos(pi/4+var.sb)/2*0 -sin(pi*swing_progress)*4, asin( sin(var.ls))*4*var.ws                                                     +sin(var.ls)*9 *clamp(-1+limb_speed*3, 0, 1) +limb_speed*4 -1*clamp(-1+limb_speed*3, 0, 1) ) +(-3.25 )*var.pose +if(is_riding, -0.5, 0)",
					"left_leg.tz": " -0.2 +if(varb.swim, todeg(body.rx)/6 +sin(pi/4+var.sb)/1.5 +cos(pi/4+var.sb)/2*0 -sin(pi*swing_progress)*4, asin(-sin(var.ls))*4*var.ws                                                     -sin(var.ls)*9 *clamp(-1+limb_speed*3, 0, 1) +limb_speed*4 -1*clamp(-1+limb_speed*3, 0, 1) ) +( 2.25 )*var.pose +if(is_riding, -0.5, 0)",
					"right_leg2.rx": "if(is_riding, -torad(80), varb.swim,  cos(pi/4+var.sb-sin(var.sb)/2*clamp(limb_speed*8, 0, 1))/3 +torad(10*clamp(limb_speed*8, 0, 1)), 0) +(-sin(limb_swing/2)/4 -torad(20) )*if(is_hurt, -sin(hurt_time*pi/5)/6*hurt_time, 0)",
					"left_leg2.rx": " if(is_riding, -torad(80), varb.swim, -cos(pi/4+var.sb+sin(var.sb)/2*clamp(limb_speed*8, 0, 1))/3 +torad(10*clamp(limb_speed*8, 0, 1)), 0) +( sin(limb_swing/2)/4 -torad(20) )*if(is_hurt, -sin(hurt_time*pi/5)/6*hurt_time, 0)",
					"right_leg2.ry": "if(is_riding,  torad(20), varb.swim, body.ry, 0)",
					"left_leg2.ry": " if(is_riding, -torad(20), varb.swim, body.ry, 0)",
					"right_leg2.rz": "if(is_riding,  0        , varb.swim, torad( 3), 0) -(sin(limb_swing/2)/2 -pi/2)/6*if(is_hurt, -sin(hurt_time*pi/5)/6*hurt_time, 0)",
					"left_leg2.rz": " if(is_riding,  0        , varb.swim, torad(-3), 0) +(sin(limb_swing/2)/2 -pi/2)/6*if(is_hurt, -sin(hurt_time*pi/5)/6*hurt_time, 0)"
				},
				{
					"r_brow.tx": "-2 +0.1*var.Cmelee +( cos(-pi/3 +var.r+var.b )/6 +0.05 )*var.nov2 +0.1*var.nov3",
					"l_brow.tx": "-r_brow.tx",
					"var.brows_y": "-2 +clamp(-sin(var.r+age /110)*4, -0.3, 0) +(1-cos(torad(head_pitch)))/2 -0.3*sin(hurt_time*pi/10)*(-0.5+sin(limb_swing/3)) +0.5*( cos(-pi/3 +var.r+var.b )/1.5 -0.1 )*var.nov2 -0.2*var.nov1 -sin(pi*swing_progress)*(1-0.7*(1-var.Bmelee))",
					"r_brow.ty": "var.brows_y +clamp(-torad(var.hy)/2, -0.5, 0.2)*clamp(-sin(var.r+age/90)*6, 0, 1)*(0.6+0.4*var.ylook*random(id)) +if(limb_speed>0.5, sin(pi/4+var.ls*2)/12*limb_speed*(1+random(sin(id))), 0) +0.4*var.nov3 +(-0.5 +0.5*random(id) +sin(-var.r)/3)*var.Cmelee",
					"l_brow.ty": "var.brows_y +clamp( torad(var.hy)/2, -0.5, 0.2)*clamp(-sin(var.r+age/90)*6, 0, 1)*(0.6+0.4*var.ylook*random(id)) +if(limb_speed>0.5, sin(     var.ls*2)/12*limb_speed*(1+random(cos(id))), 0) +0.8*var.nov3 +(-0.5 +0.5*random(id) +cos(-var.r)/3)*var.Cmelee",
					"r_brow.rz": " torad(5)*clamp(-4 +sin(var.r +age/97)*8, 0, 1)*random(id) +torad( 10)*var.Cmelee +( cos(-pi/3 +var.r+var.b )/10 +torad(2) )*var.nov2 +torad(5)*var.nov3",
					"l_brow.rz": "-torad(5)*clamp(-4 +sin(var.r +age/97)*8, 0, 1)*random(id) +torad(-10)*var.Cmelee -( cos(-pi/3 +var.r+var.b )/10 +torad(2) )*var.nov2 -torad(5)*var.nov3",
					"varb.blink": "( (1.5 -abs(sin(var.r+age/8)*6) )*clamp(-32 +cos((var.r+age/8)/1.5)*40 +cos((var.r+age/8)/4)*40, 0, 1) )>0.5 || hurt_time>5 || !is_alive",
					"var.pupil_y": "clamp(head_pitch/90, -0.5, 0.5) -cos(var.r+var.b +sin(var.r+var.b) )/8*var.nov2 +clamp(2*var.nov1, 0, 0.3) +torad(15 +7*random(id))*clamp(sin(limb_speed*3), 0, 1)/2*var.fold",
					"var.pupil_x": "sin(head.ry) -var.hy/37 +(-sin(pi/4+var.r+age/10)*3 )*clamp(var.nov1*4, 0, 1)",
					"r_pupil.tx": "clamp( var.pupil_x+head.ry, -1, 1 )/2 -2",
					"l_pupil.tx": "clamp( var.pupil_x+head.ry, -1, 1 )/2 +2",
					"r_pupil.ty": "clamp( var.pupil_y, -0.3, 0.4 ) -5",
					"l_pupil.ty": "clamp( var.pupil_y, -0.3, 0.4 ) -5",
					"eyes_open.visible": "!varb.blink",
					"r_eye_closed.visible": "varb.blink",
					"l_eye_closed.visible": "varb.blink || var.nov3==1",
					"var.distance": "clamp( sqrt( pow(pos_x-player_pos_x, 2) +pow(pos_y-player_pos_y, 2) +pow(pos_z-player_pos_z, 2) )-3, 0, 128 )",
					"r_pupil.tz": "var.distance/1600 -4",
					"l_pupil.tz": "var.distance/1600 -4",
					"eyes_back.tz": "var.distance/600 -4",
					"r_brow.tz": "-var.distance/400",
					"l_brow.tz": "-var.distance/400"
				},
