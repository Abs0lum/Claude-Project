					"body.rz": "0"
				},
				{
					"right_arm.rx": "(-torad(20) +cos(var.b)/8 +(cos(var.swls -sin(var.swls))*1.3 +torad(20))*limb_speed +var.tilt)*var.swim +( (torad(50) -clamp(var.tilt, 0, 2) +cos(var.b)/3)*var.jump +(( sin(var.ls) -torad(10) )*clamp(limb_speed*3, 0, 1)*clamp(-cos(var.ls), 0, 1))*(1-var.jump) )*(1-var.swim)",
