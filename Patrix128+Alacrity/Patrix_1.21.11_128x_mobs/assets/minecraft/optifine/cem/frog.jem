				{
					"right_leg.rx": "(-torad(10) +cos(var.b)/8 +(cos(var.swls -sin(var.swls))/1.5 -torad(20))*limb_speed)*var.swim +( (torad(10) -sin(var.b)/4)*var.jump +(( cos(torad(40-20)+var.ls)/1.1 )*clamp(limb_speed*3, 0, 1)*clamp( sin(torad(40-20)+var.ls), 0, 1))*(1-var.jump) )*(1-var.swim) +var.tilt*if(is_in_water, 1, 1.5)",
