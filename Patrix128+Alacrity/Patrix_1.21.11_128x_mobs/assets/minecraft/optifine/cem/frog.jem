					"right_leg.rz": "( torad(40) -(cos(var.swls -sin(var.swls))/5 -torad(10))*limb_speed)*var.swim +( (-torad(10) +sin(pi/4+var.b)/6)*var.jump +(clamp(sin(torad(20-20)+var.ls)/3 *clamp(limb_speed*3, 0, 1),  0, 1))*(1-var.jump) )*(1-var.swim)",
