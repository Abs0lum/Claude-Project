					"right_arm.ry": "( torad(15) +(cos(var.swls) -torad(60))/4*limb_speed)*var.swim +(-torad(20)*var.jump +(-torad(7)*clamp(1-limb_speed*3, 0, 1))*(1-var.jump) )*(1-var.swim)",
					"left_arm.ry": " (-torad(15) -(cos(var.swls) -torad(60))/4*limb_speed)*var.swim +( torad(20)*var.jump +( torad(7)*clamp(1-limb_speed*3, 0, 1))*(1-var.jump) )*(1-var.swim)",
					"right_arm.rz": "  torad(20)*var.swim +( ( torad(20)*var.jump +var.tilt/2 +cos(pi/4+var.b)/6 )*var.jump +(clamp(-cos(var.ls)/3 *clamp(limb_speed*3, 0, 1),  0, 1))*(1-var.jump) )*(1-var.swim)",
