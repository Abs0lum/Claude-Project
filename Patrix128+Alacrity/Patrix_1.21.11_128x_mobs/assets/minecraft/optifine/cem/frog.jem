			"animations": [
				{
					"var.a": "1",
					"var.r": "random(id)*pi*4",
					"var.b": "var.r +age/9",
					"var.ls": "var.r +limb_swing/1.5",
					"var.swls": "var.r +limb_swing/3",
					"var.swim": "clamp(if(                                                                              is_in_water, min(20, var.swim +0.2 *frame_time*20), max(0, var.swim -0.2 *frame_time*20)), 0, 1)",
					"var.jump": "clamp(if(var.swim==0&&!is_riding&&!is_on_ground&&right_leg.rx>torad(40)||!is_riding&&!is_on_ground, min(20, var.jump +0.3 *frame_time*20), max(0, var.jump -0.3 *frame_time*20)), 0, 1)",
					"var.tilt": "clamp(if(age>8&&var.y!=pos_y, -(pos_y-var.y), 0), -pi/4, pi/4)"
				},
				{
					"body2.rx": "(cos(var.b)/40 -torad(5) -(cos(var.swls)/10)*limb_speed)*var.swim   +((sin(var.b)/10)*var.jump +(sin(torad(20)+var.b*2)/80 +( sin(var.ls*2     )/14 -torad(3))*clamp(0.5+(limb_speed*2), 0, 1 -0.3*clamp(-3+limb_speed*4, 0, 1)))*(1-var.jump) )*(1-var.swim) +clamp(torad(head_pitch)/2, -pi/8, pi/8) +var.tilt/1.5",
					"body2.ry": "                                                                                 +(                          (                           ( sin(var.ls +cos(var.ls*2)/4)/16)*clamp(     limb_speed*3 , 0, 1 -0.3*clamp(-3+limb_speed*4, 0, 1)))*(1-var.jump) )*(1-var.swim) +clamp(torad(head_yaw)/2, -torad(20), torad(20))",
					"body2.rz": "                                                                                  ((cos(var.b)/20)*var.jump +(                           (-cos(var.ls +cos(var.ls*2)/4)/10)*clamp(     limb_speed*3 , 0, 1 -0.3*clamp(-3+limb_speed*4, 0, 1)))*(1-var.jump) )*(1-var.swim)",
					"body2.ty": "-3                             +(sin(var.b)/2)*var.swim                          +(                          (sin(          var.b*2)/8  +( sin(torad(-45)+var.ls*2)/3 -0.5)*clamp(0.5+(limb_speed*2), 0, 1 -0.3*clamp(-3+limb_speed*4, 0, 1)))*(1-var.jump) )*(1-var.swim) +clamp(-torad(head_pitch), -pi/4, pi/4) +clamp(torad(head_pitch), -pi/4, pi/4) +if(is_riding, -1, 0)",
					"body2.tz": "(-(cos(var.swls))*4*limb_speed)*var.swim +clamp(-torad(head_pitch), -pi/4, pi/4)",
					"head2.rx": "head.rx/1.2 +if(is_on_ground, (sin(var.ls/2)/20 +torad(-10))*clamp(-3+limb_speed*4, 0, clamp(sin(var.r+age/26)*2, 0, 1-croaking_body.sx)) +clamp(sin(var.r+age/2 +sin(var.r+age/2*2)/3)/6, -1, 0)*clamp(-159+sin(var.r+age/128)*160, 0, 1), 0)*(1-var.swim)",
