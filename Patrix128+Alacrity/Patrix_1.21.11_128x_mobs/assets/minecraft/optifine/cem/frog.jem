					"right_leg.tx": "-4 +( 0.5 +(cos(torad(25)+var.swls -sin(torad(25)+var.swls))*1.5 +1.5)*limb_speed)*var.swim +( ( 1.6 -clamp(var.tilt, 0, 1))*var.jump )*(1-var.swim)",
					"left_leg.tx": "  4 +(-0.5 -(cos(torad(25)+var.swls -sin(torad(25)+var.swls))*1.5 +1.5)*limb_speed)*var.swim +( (-1.6 +clamp(var.tilt, 0, 1))*var.jump )*(1-var.swim)",
