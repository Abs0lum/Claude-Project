					"right_arm2.rx": "( (-sin(pi/9+var.b*2)/40 +clamp(( sin(var.ls) -1 )/6*clamp(0.3+(limb_speed*2), 0, 1), -2, 2))*(1-var.jump) )*(1-var.swim) +clamp(-torad(head_yaw)/2, -torad(20), torad(20)) +clamp(torad(head_pitch), -pi/4, 0)/6",
					"left_arm2.rx": " ( (-sin(pi/9+var.b*2)/40 +clamp((-sin(var.ls) -1 )/6*clamp(0.3+(limb_speed*2), 0, 1), -2, 2))*(1-var.jump) )*(1-var.swim) +clamp( torad(head_yaw)/2, -torad(20), torad(20)) +clamp(torad(head_pitch), -pi/4, 0)/6",
					"right_arm2.rz": "( (-body2.ry +clamp(torad(head_yaw)/2, -torad(20), torad(20)))*(1-var.jump) )*(1-var.swim) +clamp(-torad(head_yaw)/2, -torad(20), torad(20))",
					"left_arm2.rz": " ( (-body2.ry +clamp(torad(head_yaw)/2, -torad(20), torad(20)))*(1-var.jump) )*(1-var.swim) +clamp(-torad(head_yaw)/2, -torad(20), torad(20))",
					"right_arm2.sx": "1 +( ( sin(pi/9+var.b*2)/24/2)*(1-var.jump) )*(1-var.swim) -clamp(-torad(head_pitch), -pi/4, pi/4)/6",
					"left_arm2.sx": " 1 +( ( sin(pi/9+var.b*2)/24/2)*(1-var.jump) )*(1-var.swim) -clamp(-torad(head_pitch), -pi/4, pi/4)/6",
					"right_arm2.sy": "1 +( (-sin(pi/9+var.b*2)/24  )*(1-var.jump) )*(1-var.swim) +clamp(-torad(head_pitch), -pi/4, pi/4)/4",
					"left_arm2.sy": " 1 +( (-sin(pi/9+var.b*2)/24  )*(1-var.jump) )*(1-var.swim) +clamp(-torad(head_pitch), -pi/4, pi/4)/4",
