					"right_leg.tz": "2.5 +(1 +body2.tz +(cos(torad(45)+var.swls -sin(torad(45)+var.swls))*1.5 +1)*limb_speed +clamp(-var.tilt*4, -pi, 0))*var.swim +( (2 -var.tilt*2)*var.jump +( (asin( cos(torad(20)+var.ls))*pi/5*1.5 +0.3)*clamp(0.5+(limb_speed*2), 0, 1))*(1-var.jump) )*(1-var.swim)",
					"left_leg.tz": " 2.5 +(1 +body2.tz +(cos(torad(45)+var.swls -sin(torad(45)+var.swls))*1.5 +1)*limb_speed +clamp(-var.tilt*4, -pi, 0))*var.swim +( (2 -var.tilt*2)*var.jump +( (asin(-cos(torad(20)+var.ls))*pi/5*1.5 +0.3)*clamp(0.5+(limb_speed*2), 0, 1))*(1-var.jump) )*(1-var.swim)",
					"right_foot.rx": "(torad(80) +sin(var.b)/4 +(cos(torad(45)+var.swls -sin(torad(25)+var.swls)) +torad(30))*limb_speed)*var.swim +( (torad(120) -var.tilt*2 +cos(var.b)/2)*var.jump +( (-sin(torad(-40-20)+var.ls) +pi/5 )/2*clamp(limb_speed*3, 0, 1)*clamp( sin(torad(40-20)+var.ls), 0, 1) +clamp(-right_leg.rx, -1, 0))*(1-var.jump) )*(1-var.swim)",
