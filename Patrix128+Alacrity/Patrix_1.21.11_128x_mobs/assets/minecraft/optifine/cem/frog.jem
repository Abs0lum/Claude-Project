					"right_arm.tz": "-2.8 +(body2.tz +(sin(torad(45)+var.swls +cos(torad(45)+var.swls)))*limb_speed +0.5 )*var.swim +( (var.tilt)*var.jump +((asin( sin(var.ls))*pi/5*1.5 +0.5)*clamp(0.3+(limb_speed*2), 0, 1))*(1-var.jump) )*(1-var.swim) -4*var.a",
					"left_arm.tz": " -2.8 +(body2.tz +(sin(torad(45)+var.swls +cos(torad(45)+var.swls)))*limb_speed +0.5 )*var.swim +( (var.tilt)*var.jump +((asin(-sin(var.ls))*pi/5*1.5 +0.5)*clamp(0.3+(limb_speed*2), 0, 1))*(1-var.jump) )*(1-var.swim) -4*var.a",
					"right_hand.rx": "(torad(11) -sin(var.b)/5 +(sin(var.swls -sin(var.swls))/1.5 +torad(40))*limb_speed)*var.swim +( (torad(20) -var.tilt +sin(var.b)/2)*var.jump +((-cos(var.ls)*2 -pi/2 )*clamp(limb_speed*3, 0, 1)*clamp(-cos(var.ls), 0, 1))*(1-var.jump) )*(1-var.swim)",
					"left_hand.rx": " (torad(11) -sin(var.b)/5 +(sin(var.swls -sin(var.swls))/1.5 +torad(40))*limb_speed)*var.swim +( (torad(20) -var.tilt -sin(var.b)/2)*var.jump +(( cos(var.ls)*2 -pi/2 )*clamp(limb_speed*3, 0, 1)*clamp( cos(var.ls), 0, 1))*(1-var.jump) )*(1-var.swim)",
