											"uvEast": [24, 7, 31, 13],
											"uvSouth": [46, 7, 54, 13],
											"uvWest": [39, 7, 46, 13],
											"uvUp": [39, 7, 31, 0],
											"uvDown": [47, 0, 39, 7]
										}
									]
								}
							]
						}
					]
				}
			]
		},
