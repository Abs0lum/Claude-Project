{
	"credit": "Created by FreshLX for Patrix",
	"textureSize": [64, 64],
	"models": [
		{
			"part": "head",
			"id": "head",
			"invertAxis": "xy",
			"translate": [0, 0, 0],
			"submodels": [
				{
					"id": "Created_by_FreshLX_for_Patrix",
					"invertAxis": "xy",
					"translate": [0, 0, 0]
				}
			],
			"animations": [
				{
					"varb.pfc": "frame_counter == var.pre_frame_counter",
					"var.child_scale": "if(is_child, 1, 0)",
					"var.right_arm_rx": "if( varb.pfc, var.right_arm_rx, right_arm.rx )",
					"var.left_arm_rx": " if( varb.pfc,  var.left_arm_rx,  left_arm.rx )",
					"var.right_arm_ry": "if( varb.pfc, var.right_arm_ry, right_arm.ry )",
					"var.left_arm_ry": " if( varb.pfc,  var.left_arm_ry,  left_arm.ry )",
					"var.right_arm_rz": "if( varb.pfc, var.right_arm_rz, right_arm.rz )",
					"var.left_arm_rz": " if( varb.pfc,  var.left_arm_rz,  left_arm.rz )",
					"var.right_leg_rx": "if( varb.pfc, var.right_leg_rx, right_leg.rx )",
					"var.left_leg_rx": " if( varb.pfc,  var.left_leg_rx,  left_leg.rx )",
					"var.Rspearhold": "clamp( if( varb.pfc, var.Rspearhold, swing_progress==0 &&  var.left_arm_ry==0 && ( between( var.right_arm_rx -sin(age/20*1.34)*0.05 -torad(head_pitch) +0.8, -0.55, 0 ) || between( var.right_arm_ry-torad(head_yaw)+0.1, -0.05, 0.05 ) ), var.Rspearhold +frame_time, var.Rspearhold -frame_time ), 0, 1)",
					"var.Lspearhold": "clamp( if( varb.pfc, var.Lspearhold, swing_progress==0 && var.right_arm_ry==0 && ( between(  var.left_arm_rx +sin(age/20*1.34)*0.05 -torad(head_pitch) +0.8, -0.55, 0 ) || between(  var.left_arm_ry-torad(head_yaw)-0.1, -0.05, 0.05 ) ), var.Lspearhold +frame_time, var.Lspearhold -frame_time ), 0, 1)",
					"var.spear_r": "0.5-0.5*cos( clamp( -1 +var.Rspearhold*2, 0, 1 )*pi )",
					"var.spear_l": "0.5-0.5*cos( clamp( -1 +var.Lspearhold*2, 0, 1 )*pi )",
					"var.ls": "limb_swing/if(is_child, 3, 1)/1.3",
					"var.pre_frame_counter": "frame_counter"
				},
				{
					"head.rx": "torad(if(is_child, -5, 3)) +sin(torad( 45)+var.ls*2)/8*limb_speed +sin(torad(-90)+(limb_swing/2+age)/if(is_child, 17, 30)*pi)/40 +torad(head_pitch)/1.4 +clamp(torad(head_yaw)/2, 0, pi/2) +clamp(torad(head_yaw)/4, -pi/2, 0) -sin(pi*2*swing_progress)/3",
					"head.ry": "torad(head_yaw)/1.2",
					"head.rz": "-sin(          var.ls)/if(is_child, 8, 4)*limb_speed +clamp(torad(head_yaw)/2, 0, pi/2) -sin(pi*swing_progress)/3 +torad(2)*clamp(1-limb_speed*2, 0, 1)",
					"head.tx": "( -cos(torad(20)+var.ls)*if(is_child, 1, 2)*limb_speed -torad(head_yaw)                   +sin(pi*swing_progress)*2 ) * (1-0.5*var.child_scale)",
					"head.ty": "( 1 +if(is_child, -limb_speed -0.5, 0) +(sin((limb_swing/2+age)/if(is_child, 17, 30)*pi -cos((limb_swing/2+age)/if(is_child, 17, 30)*pi)/3)/2*if(is_child, -1, 1) -sin(torad(if(is_child, -45, 30))+var.ls*2 +cos(var.ls*2)/3)*if(is_child, 1.5, 1)*clamp(limb_speed*2, 0, 1))/if(is_child, 1.5, 1) +sin(pi*swing_progress)*2 ) * (1-0.5*var.child_scale) +if(is_child, 12, 0)*var.child_scale",
					"head.tz": "( (if(is_child, -1, -4.7 +clamp(2-limb_speed*4, 0, 2)) -sin(torad(-20)+(limb_swing/2+age)/if(is_child, 17, 30)*pi -cos((limb_swing/2+age)/if(is_child, 17, 30)*pi)/3) -sin(-pi*swing_progress))/if(is_child, 1.5, 1) +1*clamp(limb_speed*2, 0, 1) ) * (1-0.5*var.child_scale)",
					"body.rx": "torad(if(is_child, -5, 20)) +sin((limb_swing/2+age)/if(is_child, 17, 30)*pi -cos((limb_swing/2+age)/if(is_child, 17, 30)*pi)/3)/10 +sin(pi*swing_progress)/3",
					"body.ry": " torad(head_yaw)/6  -sin(torad(-45)+var.ls)/4*clamp(limb_speed*1.3, 0, 1) +sin(-pi*swing_progress)/1.2",
					"body.rz": "-torad(head_yaw)/14 -cos(torad( 45)+var.ls)/if(is_child, 6, 16)*limb_speed -sin(pi*swing_progress)/3",
					"body.tx": "head.tx",
					"body.ty": "head.ty*if(is_child, 1.3, 1) +if(is_child, -3.75, 0)*var.child_scale",
					"body.tz": "head.tz +1"
				},
				{
					"right_arm.rx": "if(is_riding&&!is_child, -pi/4, 0) +var.spear_r*( torad(head_pitch/2 +if(is_riding,-20, 0) ) +if(is_child,-pi/4, 0) ) +(1-var.spear_r)*( if(is_in_lava, torad(-60), 0) +if(is_child, torad(-70 +30*limb_speed), clamp(limb_speed*2, torad(-10), torad(10))) +torad(head_yaw)/8 -sin(torad(30)+var.ls)/if(is_child, 3, 1.5)*limb_speed )  +clamp(torad(-120)*limb_speed*2, if(is_child, torad(-40), torad(-70)), 0) +sin((limb_swing/2+age)/if(is_child, 17, 30)*pi-torad(60))/20 -sin(pi*2*swing_progress) -sin(swing_progress*pi)/2",
					"left_arm.rx": " if(is_riding&&!is_child, -pi/4, 0) +var.spear_l*( torad(head_pitch/2 +if(is_riding,-20, 0) ) +if(is_child,-pi/4, 0) ) +(1-var.spear_l)*( if(is_in_lava, torad(-60), 0) +if(is_child, torad(-70 +30*limb_speed), clamp(limb_speed*2, torad(-10), torad(10))) -torad(head_yaw)/8 +sin(torad(30)+var.ls)/if(is_child, 3, 1.5)*limb_speed )  +clamp(torad(-120)*limb_speed*2, if(is_child, torad(-40), torad(-70)), 0) +sin((limb_swing/2+age)/if(is_child, 17, 30)*pi-torad(60))/20 +sin(pi*swing_progress)*2",
					"right_arm.ry": "var.spear_r*torad( head_yaw/1.5 -10 ) +(1-var.spear_r)*( clamp(-(head_yaw/80)*right_arm.rx/2, torad(-30), torad(30)) +torad(-15) +if(is_child, torad( 20), 0) )  +clamp(torad( 25)*limb_speed*2, 0, torad( 25))/2 +sin(torad( 90)+(limb_swing/2+age)/if(is_child, 17, 30)*pi)/10 +(-sin(var.ls)/3)*clamp(limb_speed*1.3, 0, 1)*max(0,1-if(is_child, 1, 0.7)*var.spear_r)",
					"left_arm.ry": " var.spear_l*torad( head_yaw/1.5 +10 ) +(1-var.spear_l)*( clamp(-(head_yaw/80)* left_arm.rx/2, torad(-30), torad(30)) +torad( 15) +if(is_child, torad(-20), 0) )  +clamp(torad(-25)*limb_speed*2, torad(-25), 0)/2 +sin(torad(-90)+(limb_swing/2+age)/if(is_child, 17, 30)*pi)/10 +(-sin(var.ls)/3)*clamp(limb_speed*1.3, 0, 1)*max(0,1-if(is_child, 1, 0.7)*var.spear_l) +sin(-pi/2*swing_progress*2)/4",
					"right_arm.rz": "(1-var.spear_r)*( if(is_in_water||is_in_lava, torad( 15), torad( 20)*limb_speed) +torad(8) )  +clamp(-torad(head_pitch)/8, 0, torad( 45)) +cos((limb_swing/2+age)/if(is_child, 17, 30)*pi +sin((limb_swing/2+age)/if(is_child, 17, 30)*pi)/2)/12 -sin(pi*swing_progress*2)/2",
					"left_arm.rz": " (1-var.spear_l)*( if(is_in_water||is_in_lava, torad(-15), torad(-20)*limb_speed) -torad(8) )  +clamp( torad(head_pitch)/8, torad(-45), 0) -cos((limb_swing/2+age)/if(is_child, 17, 30)*pi +sin((limb_swing/2+age)/if(is_child, 17, 30)*pi)/2)/12 -sin(pi*swing_progress)",
					"right_arm.tx": "( -5 +sin(pi*swing_progress)*3 ) * (1-0.5*var.child_scale) +body.tx*0.9",
					"left_arm.tx": " (  5 -sin(pi*swing_progress)*3 ) * (1-0.5*var.child_scale) +body.tx*0.9",
					"right_arm.ty": "( 2.7 -limb_speed +sin(torad(-60)+(limb_swing/2+age)/if(is_child, 17, 30)*pi -cos((limb_swing/2+age)/if(is_child, 17, 30)*pi)/3)/1.5*if(is_child, 0, 1) -sin(var.ls*2)*limb_speed -sin(pi*swing_progress*2)*2 +sin(pi*swing_progress) ) * (1-0.5*var.child_scale) +body.ty",
					"left_arm.ty": " ( 2.7 -limb_speed +sin(torad(-60)+(limb_swing/2+age)/if(is_child, 17, 30)*pi -cos((limb_swing/2+age)/if(is_child, 17, 30)*pi)/3)/1.5*if(is_child, 0, 1) -sin(var.ls*2)*limb_speed -sin(pi*swing_progress)                             ) * (1-0.5*var.child_scale) +body.ty",
					"right_arm.tz": "( clamp(2-limb_speed*6, 0, 2) -sin(torad(-20)+(limb_swing/2+age)/if(is_child, 17, 30)*pi -cos((limb_swing/2+age)/if(is_child, 17, 30)*pi)/3) +if(is_child, -2, -4 -sin(var.ls)*3*limb_speed) +torad(head_yaw) -sin(-pi*swing_progress)/if(is_child, 1.5, 1) +2*clamp(limb_speed*2, 0, 1) -sin(pi*swing_progress)*4 ) * (1-0.5*var.child_scale)",
					"left_arm.tz": " ( clamp(2-limb_speed*6, 0, 2) -sin(torad(-20)+(limb_swing/2+age)/if(is_child, 17, 30)*pi -cos((limb_swing/2+age)/if(is_child, 17, 30)*pi)/3) +if(is_child, -2, -4 +sin(var.ls)*3*limb_speed) -torad(head_yaw) -sin(-pi*swing_progress)/if(is_child, 1.5, 1) +2*clamp(limb_speed*2, 0, 1) +sin(pi*swing_progress)*6 ) * (1-0.5*var.child_scale)"
				},
				{
					"right_leg.rx": "if(is_riding, torad(-85), clamp(torad( 10)-limb_speed, 0, torad( 10)) -sin(torad(20)+(limb_swing/2+age)/if(is_child, 17, 30)*pi)/40 +sin(var.ls)/9 +sin(var.ls)/if(is_child, 1.3, 1.5)*limb_speed +clamp(-cos(torad(45)+var.ls)/2*clamp(limb_speed*1.5, 0, 1), 0, torad(30)) +torad(if(is_child, 0, 7))*limb_speed +if(is_child, torad(2), 0)) -torad(head_yaw)/30 +(sin(-pi*swing_progress)/5)",
					"left_leg.rx": " if(is_riding, torad(-85), clamp(torad(-10)+limb_speed, torad(-10), 0) -sin(          (limb_swing/2+age)/if(is_child, 17, 30)*pi)/40 -sin(var.ls)/9 -sin(var.ls)/if(is_child, 1.3, 1.5)*limb_speed +clamp( cos(torad(45)+var.ls)/2*clamp(limb_speed*1.5, 0, 1), 0, torad(30)) +torad(if(is_child, 0, 7))*limb_speed +if(is_child, torad(2), 0)) +torad(head_yaw)/30 +(sin(-pi*swing_progress)/5)",
					"right_leg.ry": "if(is_riding, torad( 10), torad( 5)) +clamp(torad(20)-limb_speed, 0, torad(20)) +clamp(-sin(var.ls)/4*clamp(if(is_child, limb_speed*1.5, -cos(limb_speed*pi)), 0, 1), torad(-10), 0)",
					"left_leg.ry": " if(is_riding, torad(-10), torad(-5)) +clamp(torad(-5)+limb_speed, torad(-5), 0) +clamp(-sin(var.ls)/4*clamp(if(is_child, limb_speed*1.5, -cos(limb_speed*pi)), 0, 1), 0, torad( 10))",
					"right_leg.rz": "if(is_riding,          0, torad( 6) +right_leg.rx *right_leg.ry)",
					"left_leg.rz": " if(is_riding,          0, torad(-6) + left_leg.rx * left_leg.ry)",
					"right_leg.tx": "( -2 -sin(var.ls +sin(var.ls)/2)*limb_speed ) * (1-0.5*var.child_scale)",
					"left_leg.tx": " (  2 -sin(var.ls +sin(var.ls)/2)*limb_speed ) * (1-0.5*var.child_scale)",
					"right_leg.ty": "( 0.2 +clamp(12 +sin(torad(45)+var.ls)*4*limb_speed -(limb_speed) +if(is_child, 0, (head.ty-if(is_child, 12, 0)*var.child_scale)*limb_speed*2), 0, 12.2) ) * (1-0.5*var.child_scale) +if(is_child, 12, 0)*var.child_scale",
					"left_leg.ty": " ( 0.2 +clamp(12 -sin(torad(45)+var.ls)*4*limb_speed -(limb_speed) +if(is_child, 0, (head.ty-if(is_child, 12, 0)*var.child_scale)*limb_speed*2), 0, 12.2) ) * (1-0.5*var.child_scale) +if(is_child, 12, 0)*var.child_scale",
					"right_leg.tz": "( if(is_child, 0, clamp(2-limb_speed*4, 0, 2)) +clamp((sin(torad( 90)+var.ls)*6)*clamp(limb_speed*1.5, 0, 1) +(3*limb_speed), -6, 1) +if(is_child, -0.5, -0.2                             ) +if(is_riding, 0, +sin(torad(20)+(limb_swing/2+age)/if(is_child, 17, 30)*pi)/3) +torad(head_yaw)/2 +(sin(pi*swing_progress)*2) ) * (1-0.5*var.child_scale)",
					"left_leg.tz": " ( if(is_child, 0, clamp(2-limb_speed*4, 0, 2)) +clamp((sin(torad(-90)+var.ls)*6)*clamp(limb_speed*1.5, 0, 1) +(3*limb_speed), -6, 1) +if(is_child, -0.5, -0.2 -clamp(2-limb_speed*6, 0, 2)) +if(is_riding, 0, +sin(          (limb_swing/2+age)/if(is_child, 17, 30)*pi)/3) -torad(head_yaw)/2 +(sin(pi*swing_progress)*2) ) * (1-0.5*var.child_scale)"
				}
			]
		},
