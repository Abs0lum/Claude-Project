{
	"credit": "Created by FreshLX for Patrix",
	"textureSize": [128, 128],
	"models": [
		{
			"part": "body",
			"id": "body",
			"invertAxis": "xy",
			"translate": [0, -5, 0],
			"submodels": [
				{
					"id": "Created_by_FreshLX_for_Patrix",
					"invertAxis": "xy",
					"translate": [0, 0, 0]
				}
			],
			"animations": [
				{
					"var.testing": "0",
					"var.fly": "clamp(if(!is_riding&&!is_on_ground, min(20, var.fly +0.3 *frame_time*20), max(0, var.fly -0.3 *frame_time*20)), 0, 1)",
					"var.r": "(pi*random(id)*4)",
					"var.baby": "if(is_child, 0.8, 1)",
					"var.att": "if(is_on_ground, 0, (body.rx -(right_antenna.rx/3*2.5 +0.1)) )",
					"var.stingless": "if(stinger.visible, 0, 1)",
					"var.b": "var.r +age / 8.5 *if(is_child, 1.7, 1)",
					"var.ls": "limb_swing/2.6",
					"var.lsw": "limb_swing*2",
					"var.i": "clamp(1-limb_speed*2, 0, 1)",
					"var.m": "clamp(  limb_speed*2, 0, 1)",
					"var.w": "clamp(  limb_speed*4, 0, 1)",
					"var.pollen": "clamp( if(rule_index==2, min(20, var.pollen +0.1 *frame_time*20), max(0, var.pollen -0.1 *frame_time*20)), 0, 1)",
					"var.pb": "age/2 +sin(age/11) +sin(age/17)",
					"var.wing_speed": "var.r +age*3.3*if(is_child, 1.2, 1) +limb_swing*2 +(sin(age/6 -sin(age/12) )*4 -limb_swing*2 )*var.stingless"
				},
				{
					"body.sx": "( 0.7 +0.3*random(id) )",
					"body.sy": "body.sx",
					"body.sz": "body.sx",
					"body.rx": "clamp( if(!is_riding && age>10, -(pos_y-var.y), 0), -pi/3, pi/3)*var.m*var.fly -var.att/1.3",
					"body.ry": "0",
					"body.rz": "-if(age>4, clamp(rot_y-var.tilt, -pi/3, pi/3)/2, 0)*var.m*var.fly",
					"body.ty": "16 +(-3.9*random(id)-1.1)/1.65 +if(is_riding, -0.8, 0) +3",
					"body.tx": "0",
					"body.tz": "0",
					"torso2.rx": "-torad( 1 +4*sin(var.b +sin(pi/4+var.b)/3*var.i )                                                          )*var.fly -torad( sin(-pi/4+var.b*3) )*(1-var.fly) +var.att/4",
					"torso.rx": "  torad( 1 +4*sin(var.b +sin(pi/4+var.b)/3*var.i ) +10*limb_speed +5*cos(age/6 -sin(age/12) )*var.stingless )*var.fly +torad( sin(-pi/4+var.b*3) )*(1-var.fly) +torad(20)*sin(hurt_time*pi/5.2)/4*hurt_time +if(age<6, 0.5+sin( clamp(    age/6, 0, 1)*pi*1.5 )/2, 0)/4",
					"torso.ry": "torad( head_yaw/1.4*clamp(0.5 +limb_speed*1.5, 0.5, 1) )*var.fly",
					"torso.rz": "torad( cos(pi/4+var.b/3)*4 +( sin(var.ls/2) +sin(var.ls/1.7) )*2*var.m*(1+0.5*var.stingless) )*var.fly +torad( 2*sin(var.lsw)*var.w )*(1-var.fly) +if(is_aggressive||anger_time>0, torad( sin(age*2.5) ), 0) +torad(9*sin(age/6))*var.pollen",
					"torso.ty": "16*var.testing +( cos(var.b)/1 -sin(age/6 -sin(age/12) )*var.stingless )*var.fly +( 0.5 +0.5 -sin(var.b*3)/8*var.i )*(1-var.fly)",
					"torso.tx": "( sin(var.b/3)*2/(2-0.5*var.stingless) +( -cos(var.ls/2) -cos(var.ls/1.7) )*var.m*(1+0.5*var.stingless) )*var.fly +( sin(var.lsw)/5.7*var.w )*(1-var.fly) +if(is_aggressive||anger_time>0, torad( sin(age*2.5)*if(is_on_ground, 4, 1) ), 0) +(sin(-pi/6+age/6)/1.3)*var.pollen",
					"torso.tz": "( cos(var.b)/1.5*var.m )*var.fly +( -sin(-pi/4+var.b*3)/14.5 )*(1-var.fly) -sin(hurt_time*pi/5)/2*hurt_time +if(age<5, 8-sin( clamp(age/5, 0, 1)*pi/2 )*8, 0)",
					"torso.sx": "1 -if(age<4, cos( clamp(    age/4, 0, 1)*pi*1.5 )/5, 0)",
					"torso.sy": "1 -if(age<4, cos( clamp(    age/4, 0, 1)*pi*1.5 )/5, 0)",
					"torso.sz": "1 -if(age<4, cos( clamp(0.2+age/4, 0, 1)*pi*1.5 )/5, 0)",
					"head.rx": "torad( head_pitch/2*clamp(1-limb_speed*3, 0, 1) +1 -10*limb_speed +4*cos(var.b +sin(pi/4+var.b)/8*var.i ) )*var.fly +torad( cos(      var.b*3) )*(1-var.fly)  -if(age<6, 0.5+sin( clamp(    age/6, 0, 1)*pi*1.5 )/2, 0)/2 +torad(-15 +25*var.pollen) +var.att/3",
					"head.ry": "torad( head_yaw/2 )",
					"head.rz": "torad( head_yaw/4 ) -body.rz -torso.rz +torad(clamp(+(sin(age/12)+cos(age/8))*90, -8, 8))*var.pollen",
					"head.sx": "if(is_child, 1.2, 1)",
					"head.sy": "head.sx",
					"head.sz": "head.sx",
					"render.shadow_size": "body.sx/3"
				},
				{
					"left_wing2.rx": " torad( 5 -5*sin(var.wing_speed) )*var.fly +torad( 20 -2*sin(var.b*3) )*(1-var.fly)",
					"right_wing2.rx": "left_wing2.rx",
					"left_wing2.ry": " torad( 10 +10*clamp(1-limb_speed*2, 0, 1) +20*cos(var.wing_speed)*(-0.5+limb_speed*2) )*var.fly +torad( -20 -1*sin(var.b*3) )*(1-var.fly) +torad( 10 )*sin(hurt_time*pi/4)/6*hurt_time",
					"right_wing2.ry": "-left_wing2.ry",
					"left_wing2.rz": "  torad(-46 +45*sin(var.wing_speed) )*var.fly +torad( -20 -5*cos(var.lsw)*var.w )*(1-var.fly)",
					"right_wing2.rz": "-torad(-46 +45*sin(var.wing_speed) )*var.fly -torad( -20 +5*cos(var.lsw)*var.w )*(1-var.fly)",
					"left_wing2.sx": "var.baby",
					"left_wing2.sy": "var.baby",
					"left_wing2.sz": "var.baby",
					"right_wing2.sx": "var.baby",
					"right_wing2.sy": "var.baby",
					"right_wing2.sz": "var.baby"
				},
				{
					"front_left_leg.rx": "  torad(-10 -10*cos(-pi/4+var.b            )*var.i +( 60 -sin(var.ls*5  )*4 )*clamp(limb_speed*2, 0, 1) +(20+40*sin(var.pb))*var.pollen )*var.fly +torad(-20 +( cos(var.lsw)*30 +20)*var.w )*(1-var.fly) +torad(-30 )*sin(hurt_time*pi/4)/6*hurt_time",
					"front_right_leg.rx": " torad(-10 -10*cos(-pi/9+var.b            )*var.i +( 60 +sin(var.ls*4.5)*4 )*clamp(limb_speed*2, 0, 1) +(20-40*sin(var.pb))*var.pollen )*var.fly +torad(-20 +(-cos(var.lsw)*30 +20)*var.w )*(1-var.fly) +torad(-30 )*sin(hurt_time*pi/4)/6*hurt_time",
					"middle_left_leg.rx": " torad( 10 -10*sin(var.b-cos(pi/6+var.b)/3)*var.i +( 50 -sin(var.ls*5.5)*4 )*clamp(limb_speed*2, 0, 1) +(   30*sin(var.pb))*var.pollen )*var.fly +torad(     ( cos(var.lsw)*30 +10)*var.w )*(1-var.fly) +torad(-10 )*sin(hurt_time*pi/4)/6*hurt_time",
					"middle_right_leg.rx": "torad( 10 -10*sin(var.b-cos(pi/6+var.b)/3)*var.i +( 50 -sin(var.ls*5.5)*4 )*clamp(limb_speed*2, 0, 1) +(  -30*sin(var.pb))*var.pollen )*var.fly +torad(     (-cos(var.lsw)*30 +10)*var.w )*(1-var.fly) +torad(-10 )*sin(hurt_time*pi/4)/6*hurt_time",
					"back_left_leg.rx": "   torad( 15 -10*sin(var.b-cos(     var.b)/3)*var.i +( 30 -sin(var.ls*5  )*4 )*clamp(limb_speed*2, 0, 1) +(  -40*cos(var.pb))*var.pollen )*var.fly +torad(     ( cos(var.lsw)*30 -20)*var.w )*(1-var.fly) +torad(-20 )*sin(hurt_time*pi/4)/6*hurt_time",
					"back_right_leg.rx": "  torad( 15 -10*sin(var.b-cos(     var.b)/3)*var.i +( 30 -sin(var.ls*5  )*4 )*clamp(limb_speed*2, 0, 1) +(   40*cos(var.pb))*var.pollen )*var.fly +torad(     (-cos(var.lsw)*30 -20)*var.w )*(1-var.fly) +torad(-20 )*sin(hurt_time*pi/4)/6*hurt_time",
					"front_left_leg.rz": "  torad( 15 -cos(pi/4+var.b/3)*4 -5*cos(-pi/4+var.b) +40*clamp(limb_speed*2, 0, 1) +(-30)*cos(hurt_time*pi/4)/6*hurt_time +(-20 +20*sin(pi/4+var.pb))*var.pollen )*var.fly -torad( clamp( sin(var.lsw)*30, 0, 30)*var.w )*(1-var.fly)",
					"front_right_leg.rz": "-torad( 15 +cos(pi/4+var.b/3)*4 -5*cos(-pi/4+var.b) +40*clamp(limb_speed*2, 0, 1) +(-30)*cos(hurt_time*pi/4)/6*hurt_time +(-20 -20*sin(pi/4+var.pb))*var.pollen )*var.fly +torad( clamp(-sin(var.lsw)*30, 0, 30)*var.w )*(1-var.fly)",
					"middle_left_leg.rz": "-torad(         5*sin(var.b-cos(pi/9+var.b)/2)      +40*clamp(limb_speed*2, 0, 1) +( 30)*cos(hurt_time*pi/4)/6*hurt_time +( 40 -30*cos(pi/4+var.pb))*var.pollen )*var.fly +torad( clamp( sin(var.lsw)*30, 0, 30)*var.w )*(1-var.fly)",
					"middle_right_leg.rz": "torad(         5*sin(var.b-cos(pi/4+var.b)/2)      +40*clamp(limb_speed*2, 0, 1) +( 30)*cos(hurt_time*pi/4)/6*hurt_time +( 40 +30*cos(     var.pb))*var.pollen )*var.fly +torad(-clamp(-sin(var.lsw)*30, 0, 30)*var.w )*(1-var.fly)",
					"back_left_leg.rz": "  torad( 10 +40*clamp(limb_speed*2, 0, 1) +(-20*sin(var.pb))*var.pollen )*var.fly +torad(-clamp( sin(var.lsw)*30, 0, 30)*var.w )*(1-var.fly)",
					"back_right_leg.rz": "-torad( 10 +40*clamp(limb_speed*2, 0, 1) +( 20*sin(var.pb))*var.pollen )*var.fly +torad( clamp(-sin(var.lsw)*30, 0, 30)*var.w )*(1-var.fly)",
					"front_left_leg.ry": "  torad( 20 )*(1-var.fly)",
					"front_right_leg.ry": "-torad( 20 )*(1-var.fly)",
					"back_left_leg.ry": "-torad( 20*clamp(limb_speed*2, 0, 1) )*(1-var.fly)",
					"back_right_leg.ry": "torad( 20*clamp(limb_speed*2, 0, 1) )*(1-var.fly)",
					"legs.rx": "-torad( sin(-pi/4+var.b*3) )*(1-var.fly)",
					"legs.rz": "(-sin(var.lsw)/28*var.w )*(1-var.fly) -if(is_aggressive||anger_time>0, torad( sin(age*2.5) ), 0)",
					"legs.sy": "1 +( sin(var.b*3)/24*var.i )*(1-var.fly)"
				},
				{
					"stinger2.visible": "stinger.visible",
					"left_antenna2.rx": " torad( 5 +30*var.stingless +5*sin(var.b-cos(pi/6+var.b))*var.i  +( 10 -sin(var.ls*4.5)*4 )*limb_speed )*var.fly +torad( 20 )*sin(hurt_time*pi/4)/6*hurt_time +torad(20 +10*cos(age/3.3))*var.pollen +torad( 15)",
					"right_antenna2.rx": "torad( 5 +30*var.stingless +5*sin(var.b-cos(pi/6+var.b))*var.i  +( 10 +sin(var.ls*4.8)*4 )*limb_speed )*var.fly +torad( 20 )*sin(hurt_time*pi/4)/6*hurt_time +torad(20 +10*sin(age/3  ))*var.pollen +torad( 15)",
					"left_antenna2.ry": "-torad( 12*( sin(var.b*1.7)/2 -cos(var.b/3)/2 )  +30*limb_speed ) +torad( 20 )*cos(hurt_time*pi/4)/6*hurt_time",
					"right_antenna2.ry": "torad( 12*( sin(var.b/3)/2 +cos(var.b*1.7)/2 )  +30*limb_speed ) +torad(-20 )*cos(hurt_time*pi/4)/6*hurt_time",
					"left_antenna2.sx": " var.baby",
					"right_antenna2.sx": "var.baby",
					"left_antenna2.sy": " var.baby",
					"right_antenna2.sy": "var.baby",
					"left_antenna2.sz": " var.baby",
					"right_antenna2.sz": "var.baby"
				},
				{
					"var.y": "var.y2",
					"var.y2": "var.y3",
					"var.y3": "var.y4",
					"var.y4": "var.y5",
