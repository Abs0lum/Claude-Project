					"coat.ty": "-11 +clamp( if(age>10, -(body.ty-var.x), 0)/8, -0.4, 0.2)*4  *limb_speed +if(!is_on_ground&&is_in_water, 0, ( cos(var.ls*2 +sin(var.ls*2)/4 )/2*limb_speed )*var.walk )",
