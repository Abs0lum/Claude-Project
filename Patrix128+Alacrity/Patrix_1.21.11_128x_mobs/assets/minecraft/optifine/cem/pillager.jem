					"r_brow.tx": "-2 +( cos(-pi/3 +var.r+var.b )/6 +0.05 )*var.nov2 +0.1*var.nov3",
					"l_brow.tx": "-r_brow.tx",
					"var.brows_y": "-2 +clamp(-sin(var.r+age /110)*4, -0.3, 0) +(1-cos(torad(head_pitch)))/2 -0.3*sin(hurt_time*pi/10)*(-0.5+sin(limb_swing/3)) +0.5*( cos(-pi/3 +var.r+var.b )/1.5 -0.1 )*var.nov2 -0.2*var.nov1",
					"r_brow.ty": "var.brows_y +clamp(-torad(var.hy)/2, -0.5, 0.2)*clamp(-sin(var.r+age/90)*6, 0, 1)*(0.6+0.4*var.ylook*random(id)) +if(limb_speed>0.5, sin(pi/4+var.ls*2)/8*limb_speed*(1+random(sin(id))), 0) +0.4*var.nov3",
					"l_brow.ty": "var.brows_y +clamp( torad(var.hy)/2, -0.5, 0.2)*clamp(-sin(var.r+age/90)*6, 0, 1)*(0.6+0.4*var.ylook*random(id)) +if(limb_speed>0.5, sin(     var.ls*2)/8*limb_speed*(1+random(cos(id))), 0) +0.8*var.nov3",
					"r_brow.rz": " torad(5)*clamp(-4 +sin(var.r +age/97)*8, 0, 1)*random(id) +( cos(-pi/3 +var.r+var.b )/10 +torad(2) )*var.nov2 +torad(5)*var.nov3",
					"l_brow.rz": "-torad(5)*clamp(-4 +sin(var.r +age/97)*8, 0, 1)*random(id) -( cos(-pi/3 +var.r+var.b )/10 +torad(2) )*var.nov2 -torad(5)*var.nov3",
					"varb.blink": "( (1.5 -abs(sin(var.r+age/8)*6) )*clamp(-32 +cos((var.r+age/8)/1.5)*40 +cos((var.r+age/8)/4)*40, 0, 1) )>0.5 || hurt_time>5 || !is_alive",
					"var.pupil_y": "clamp(head_pitch/90, -0.5, 0.5) -cos(var.r+var.b +sin(var.r+var.b) )/8*var.nov2 +clamp(2*var.nov1, 0, 0.3)",
					"var.pupil_x": "sin(head.ry) -var.hy/37 +(-sin(pi/4+var.r+age/10)*3 )*clamp(var.nov1*4, 0, 1)",
					"r_pupil.tx": "clamp( var.pupil_x+head.ry, -1, 1 )/2 -2",
					"l_pupil.tx": "clamp( var.pupil_x+head.ry, -1, 1 )/2 +2",
					"r_pupil.ty": "clamp( var.pupil_y, -0.3, 0.4 ) -5",
					"l_pupil.ty": "clamp( var.pupil_y, -0.3, 0.4 ) -5",
					"eyes_open.visible": "!varb.blink",
					"r_eye_closed.visible": "varb.blink",
					"l_eye_closed.visible": "varb.blink || var.nov3==1",
					"var.distance": "clamp( sqrt( pow(pos_x-player_pos_x, 2) +pow(pos_y-player_pos_y, 2) +pow(pos_z-player_pos_z, 2) )-3, 0, 128 )",
					"r_pupil.tz": "var.distance/1600 -4",
					"l_pupil.tz": "var.distance/1600 -4",
					"eyes_back.tz": "var.distance/600 -4",
					"r_brow.tz": "-var.distance/400",
					"l_brow.tz": "-var.distance/400"
				},
				{
					"var.pre_roty": "rot_y",
					"var.pre_headroty": "head.ry",
					"var.pre_Oheadroty": "var.headroty",
					"var.pre_frame_counter": "frame_counter"
				}
			]
		},
