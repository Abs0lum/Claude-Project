{
	"credit": "Created by FreshLX for Patrix",
	"textureSize": [32, 32],
	"models": [
		{
			"part": "tail",
			"id": "tail",
			"invertAxis": "xy",
			"translate": [0, -3, -6],
			"submodels": [
				{
					"id": "Created_by_FreshLX_for_Patrix",
					"invertAxis": "xy",
					"translate": [0, 0, 0]
				}
			],
			"animations": [
				{
					"var.hy": "clamp(head_yaw,-90,90)",
					"var.r": "random(id)*pi*4",
					"var.speed": "clamp( limb_speed*4, 0, 1 )",
					"var.fps": "1"
				},
				{
					"body.ry": "-tail.ry/6",
					"body2.ry": "      if(is_in_water, sin(var.r+limb_swing*1.65+age/10)/7*(1+limb_speed*2 ) +torad(var.hy)/2                  , -cos(limb_swing+age/2)/8*2)",
					"tail2.ry": "      if(is_in_water,-cos(var.r+limb_swing*1.65+age/10)/4*(1+var.speed*1.3) +clamp(torad(var.hy), -pi/5, pi/5), -sin(limb_swing+age/2)/3*3)",
					"tail2.rz": "      if(is_in_water, sin(var.r+limb_swing*1.65+age/10)/5                                                     , -sin(limb_swing+age/2)/3)*0",
					"fin_top2.rz": "   if(is_in_water, cos(var.r+limb_swing*1.65+age/10)/6*(1+var.speed    )                                   , -sin(limb_swing+age/2))*0",
					"fin_bottom2.rz": "if(is_in_water,-cos(var.r+limb_swing*1.65+age/10)/6*(1+var.speed    )                                   ,  sin(limb_swing+age/2))*0",
					"body2.tx": "      if(is_in_water, cos(var.r+limb_swing*1.65+age/10)/5*(1+var.speed    )                                   , -cos(limb_swing+age/2))",
					"body2.ty": "-1.5 +if(is_in_water, cos((pos_x*1.5+pos_y*2+pos_z*1.5)+age/17), 0)",
					"body2.rx": "clamp(if(age>4&&var.y!=pos_y, -(pos_y-var.y)*4*var.fps, 0), -pi/3, pi/3)",
					"tail2.rx": "      if(is_in_water, torad(-5)*clamp(1-limb_speed*6, 0, 1) -sin((pos_x*1.5+pos_y*2+pos_z*1.5)+age/23)/10, -sin(limb_swing+age/2)/6)*0",
					"body2.rz": "      if(is_in_water, -cos(var.r+limb_swing*1.65+age/10)/10 *limb_speed, torad(20) +torad(-40)*clamp(limb_speed*6, 0, 1) +sin(limb_swing +sin(limb_swing*2))/2 +limb_swing/2 -torad(90))",
					"body2.sx": "1 +(0.5-random(id))/1.5",
					"body2.sy": "body2.sx",
					"body2.sz": "body2.sx"
				},
				{
					"left_fin.rx": " torad(-20)",
					"right_fin.rx": "torad(-20)",
					"left_fin.ry": " torad(-35) +if(is_in_water,  cos(          var.r+limb_swing/2+age/5 +sin(var.r+limb_swing/2+age/10)  )/2*(1-var.speed) +(torad(-30) -sin(var.r+limb_swing*1.65+age/10)/3)*var.speed,  sin(age/1.5)/2)",
					"right_fin.ry": "torad( 35) +if(is_in_water, -sin(          var.r+limb_swing/2+age/5 +cos(var.r+limb_swing/2+age/10)  )/2*(1-var.speed) +(torad( 30) -sin(var.r+limb_swing*1.65+age/10)/3)*var.speed, -sin(age/1.5)/2)",
					"left_fin.rz": " torad( 10) +if(is_in_water, -cos(torad(30)+var.r+limb_swing/2+age/5 +sin(var.r+limb_swing/2+age/10)/2)/4*(1-var.speed) +(torad( 5 ) +sin(var.r+limb_swing*1.65+age/10)/9)*var.speed, 0)",
					"right_fin.rz": "torad(-10) +if(is_in_water,  sin(torad(30)+var.r+limb_swing/2+age/5 +cos(var.r+limb_swing/2+age/10)/2)/4*(1-var.speed) +(torad(-5 ) +sin(var.r+limb_swing*1.65+age/10)/9)*var.speed, 0)",
					"left_bottom_fin.rz": " torad( 60) +if(is_in_water,-cos(var.r+limb_swing*1.65+age/10)/6*(1+limb_speed*2),  sin(limb_swing+age/2))/2",
					"right_bottom_fin.rz": "torad(-60) +if(is_in_water,-cos(var.r+limb_swing*1.65+age/10)/6*(1+limb_speed*2),  sin(limb_swing+age/2))/2"
				},
				{
					"var.y": "var.y2",
					"var.y2": "var.y3",
					"var.y3": "var.y4",
					"var.y4": "var.y5",
					"var.y5": "var.y6",
					"var.y6": "var.y7",
					"var.y7": "var.y8",
					"var.y8": "var.y9",
					"var.y9": "var.y10",
					"var.y10": "pos_y"
				}
			]
		},
