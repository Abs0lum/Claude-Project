{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "effortLevel": "xhigh",
  "ultracode": true,
  "alwaysThinkingEnabled": true,
  "promptCacheTtl": "1h",
  "permissions": {
    "deny": [
      "Read(./_intake/secrets/**)",
      "Read(./**/.env)",
      "Read(./**/*token*.json)",
      "Read(./**/client_secret*.json)"
    ]
  }
}
