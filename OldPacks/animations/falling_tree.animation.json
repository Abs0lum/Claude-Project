{
  "format_version": "1.10.0",
  "animations": {
    "animation.ft_falling_tree.setup": {
      "loop": true,
      "bones": {
        "canopy": {
          "position": [0, "(q.property('ft:trunk_height') - 1) * 16", 0]
        }
      }
    },
    "animation.ft_falling_tree.fall": {
      "loop": false,
      "animation_length": 1.2,
      "bones": {
        "root": {
          "rotation": {
            "0.0":  { "pre": [0, 0, 0],   "post": [0, 0, 0],   "lerp_mode": "linear" },
            "0.25": { "pre": [0, 0, -3],  "post": [0, 0, -3],  "lerp_mode": "linear" },
            "0.6":  { "pre": [0, 0, -25], "post": [0, 0, -25], "lerp_mode": "linear" },
            "0.95": { "pre": [0, 0, -75], "post": [0, 0, -75], "lerp_mode": "linear" },
            "1.2":  { "pre": [0, 0, -90], "post": [0, 0, -90], "lerp_mode": "linear" }
          }
        }
      }
    }
  }
}
